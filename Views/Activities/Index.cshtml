@model List<CampusKonnect.Models.Activity>

@{
    Layout = null;
    ViewData["Title"] = "Campus Activities";
    string currentFilter = ViewBag.CurrentFilter ?? "all";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Campus Activities - CampusKonnect</title>

    <style>
        :root {
            --forest: #244C3A;
            --forest-dark: #193A2B;
            --sage: #648A70;
            --soft-sage: #E5EEE7;
            --light: #F5F8F5;
            --dark: #26352C;
            --muted: #718078;
            --border: #DFE8E0;
            --shadow: 0 12px 30px rgba(36, 76, 58, .07);
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            margin: 0;
            background: var(--light);
            color: var(--dark);
            font-family: "Segoe UI", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        a,
        button {
            -webkit-tap-highlight-color: transparent;
        }

        .main-layout {
            min-height: 100vh;
            display: flex;
        }

        .sidebar {
            position: sticky;
            top: 0;
            width: 250px;
            min-width: 250px;
            height: 100vh;
            padding: 25px 17px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            background: var(--forest);
            color: #FFFFFF;
        }

        .brand {
            margin: 0 0 35px;
            padding: 0 8px;
            display: flex;
            align-items: center;
            gap: 10px;
            color: #FFFFFF;
            font-size: 20px;
            font-weight: 760;
            letter-spacing: -.4px;
            text-decoration: none;
        }

        .brand-mark {
            width: 36px;
            height: 36px;
            flex: 0 0 auto;
            display: grid;
            place-items: center;
            border-radius: 11px;
            background: rgba(255, 255, 255, .14);
            color: #FFFFFF;
            font-size: 13px;
            font-weight: 800;
        }

        .sidebar-heading {
            margin: 0 10px 11px;
            color: #C5D8CA;
            font-size: 10px;
            font-weight: 750;
            letter-spacing: 1.2px;
        }

        .sidebar-nav {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .side-link {
            min-height: 42px;
            padding: 11px 12px;
            display: flex;
            align-items: center;
            border-radius: 9px;
            color: #E5EEE7;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            transition: background .2s ease, color .2s ease, transform .2s ease;
        }

        .side-link:hover,
        .side-link.active {
            background: rgba(255, 255, 255, .16);
            color: #FFFFFF;
        }

        .side-link:hover {
            transform: translateX(2px);
        }

        .sidebar-bottom {
            margin-top: auto;
            padding-top: 24px;
        }

        .logout-form {
            margin: 5px 0 0;
        }

        .logout-btn {
            width: 100%;
            min-height: 42px;
            padding: 10px 12px;
            border: 1px solid rgba(229, 238, 231, .55);
            border-radius: 9px;
            background: transparent;
            color: #FFFFFF;
            font: inherit;
            font-size: 13px;
            font-weight: 600;
            text-align: left;
            cursor: pointer;
            transition: background .2s ease, border-color .2s ease;
        }

        .logout-btn:hover {
            border-color: rgba(255, 255, 255, .7);
            background: rgba(255, 255, 255, .14);
        }

        .side-link:focus-visible,
        .logout-btn:focus-visible {
            outline: 3px solid rgba(255, 255, 255, .45);
            outline-offset: 2px;
        }

        .content {
            flex: 1;
            min-width: 0;
            padding: 38px clamp(20px, 4vw, 54px) 55px;
        }

        .content-inner {
            width: min(100%, 1080px);
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 27px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
        }

        .page-heading {
            min-width: 0;
        }

        .eyebrow {
            margin: 0 0 8px;
            color: var(--sage);
            font-size: 11px;
            font-weight: 750;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .page-header h1 {
            margin: 0 0 7px;
            color: var(--forest);
            font-size: clamp(26px, 4vw, 34px);
            font-weight: 760;
            letter-spacing: -.8px;
            line-height: 1.2;
        }

        .page-header p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .create-btn {
            min-height: 44px;
            padding: 11px 15px;
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 9px;
            background: var(--forest);
            color: #FFFFFF;
            font-size: 13px;
            font-weight: 700;
            text-decoration: none;
            transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
        }

        .create-btn:hover {
            transform: translateY(-2px);
            background: var(--forest-dark);
            box-shadow: 0 7px 16px rgba(36, 76, 58, .17);
            color: #FFFFFF;
        }

        .message {
            margin-bottom: 18px;
            padding: 13px 15px;
            border: 1px solid #D6E6D9;
            border-radius: 10px;
            background: #EDF5EE;
            color: var(--forest);
            font-size: 14px;
            line-height: 1.5;
        }

        .search-form {
            max-width: 720px;
            margin-bottom: 23px;
            display: flex;
            gap: 9px;
        }

        .search-form input {
            width: 100%;
            min-width: 0;
            min-height: 44px;
            padding: 10px 13px;
            border: 1px solid #D5DED7;
            border-radius: 9px;
            background: #FFFFFF;
            color: var(--dark);
            font: inherit;
            font-size: 14px;
            transition: border-color .2s ease, box-shadow .2s ease;
        }

        .search-form input::placeholder {
            color: #98A39B;
        }

        .search-form input:focus {
            outline: none;
            border-color: var(--sage);
            box-shadow: 0 0 0 3px rgba(100, 138, 112, .14);
        }

        .search-btn,
        .clear-btn {
            min-height: 44px;
            padding: 10px 15px;
            flex: 0 0 auto;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid transparent;
            border-radius: 9px;
            font: inherit;
            font-size: 13px;
            font-weight: 650;
            text-decoration: none;
            cursor: pointer;
            transition: background .2s ease, color .2s ease, border-color .2s ease;
        }

        .search-btn {
            background: var(--sage);
            color: #FFFFFF;
        }

        .search-btn:hover {
            background: var(--forest);
        }

        .clear-btn {
            border-color: var(--border);
            background: #FFFFFF;
            color: var(--dark);
        }

        .clear-btn:hover {
            border-color: #C7D7CA;
            background: var(--soft-sage);
            color: var(--forest);
        }

        .activity-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .activity-card {
            min-width: 0;
            padding: 20px;
            border: 1px solid var(--border);
            border-radius: 14px;
            background: #FFFFFF;
            box-shadow: 0 4px 14px rgba(36, 76, 58, .035);
            transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
        }

        .activity-card:hover {
            transform: translateY(-3px);
            border-color: #C6D6C9;
            box-shadow: var(--shadow);
        }

        .card-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
        }

        .activity-copy {
            min-width: 0;
        }

        .activity-title {
            margin: 0 0 7px;
            color: var(--forest);
            font-size: 17px;
            font-weight: 740;
            line-height: 1.4;
            overflow-wrap: anywhere;
        }

        .activity-description {
            margin: 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.65;
            overflow-wrap: anywhere;
        }

        .badges {
            flex: 0 0 auto;
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 6px;
        }

        .badge {
            padding: 6px 9px;
            display: inline-flex;
            align-items: center;
            border-radius: 30px;
            font-size: 11px;
            font-weight: 750;
            line-height: 1.2;
            white-space: nowrap;
        }

        .online {
            background: #E2F0F7;
            color: #245D7A;
        }

        .on-campus,
        .available {
            background: var(--soft-sage);
            color: var(--forest);
        }

        .full {
            background: #FFF0CF;
            color: #805B00;
        }

        .cancelled {
            background: #F9DEDE;
            color: #A52E2E;
        }

        .completed {
            background: #ECEEEC;
            color: #536058;
        }

        .details-grid {
            margin-top: 16px;
            padding: 13px 14px;
            display: flex;
            flex-wrap: wrap;
            gap: 10px 22px;
            border-radius: 10px;
            background: #F8FAF8;
            color: #53645A;
            font-size: 12px;
            line-height: 1.5;
        }

        .details-grid span {
            overflow-wrap: anywhere;
        }

        .details-grid strong {
            color: var(--dark);
            font-weight: 700;
        }

        .card-actions {
            margin-top: 14px;
            padding-top: 13px;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            border-top: 1px solid #EEF1EE;
        }

        .action-btn {
            min-height: 34px;
            padding: 8px 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid transparent;
            border-radius: 7px;
            font: inherit;
            font-size: 12px;
            font-weight: 700;
            line-height: 1.2;
            text-decoration: none;
            cursor: pointer;
            transition: transform .18s ease, background .18s ease, color .18s ease;
        }

        .action-btn:hover {
            transform: translateY(-1px);
        }

        .view-btn {
            background: var(--forest);
            color: #FFFFFF;
        }

        .view-btn:hover {
            background: var(--forest-dark);
            color: #FFFFFF;
        }

        .edit-btn {
            background: #FFF0CF;
            color: #765300;
        }

        .edit-btn:hover {
            background: #F8E4B2;
            color: #674900;
        }

        .join-btn {
            background: var(--soft-sage);
            color: var(--forest);
        }

        .join-btn:hover {
            background: #D1E2D5;
            color: var(--forest-dark);
        }

        .leave-btn,
        .cancel-btn {
            background: #F9DEDE;
            color: #A52E2E;
        }

        .leave-btn:hover,
        .cancel-btn:hover {
            background: #F3CACA;
            color: #8F2424;
        }

        .action-form {
            margin: 0;
        }

        .empty-state {
            padding: 25px;
            border: 1px dashed #C9D8CC;
            border-radius: 13px;
            background: #FFFFFF;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.65;
        }

        .create-btn:focus-visible,
        .search-btn:focus-visible,
        .clear-btn:focus-visible,
        .action-btn:focus-visible {
            outline: 3px solid rgba(100, 138, 112, .35);
            outline-offset: 3px;
        }

        @@media (max-width: 820px) {
            .sidebar {
                width: 220px;
                min-width: 220px;
            }

            .content {
                padding: 30px 22px 42px;
            }

            .card-top {
                flex-direction: column;
                gap: 12px;
            }

            .badges {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 600px) {
            .main-layout {
                flex-direction: column;
            }

            .sidebar {
                position: static;
                width: 100%;
                min-width: 0;
                height: auto;
                padding: 14px 15px;
                overflow: visible;
            }

            .brand {
                margin: 0 0 13px;
                padding: 0 3px;
                font-size: 18px;
            }

            .brand-mark {
                width: 33px;
                height: 33px;
                border-radius: 10px;
            }

            .sidebar-heading {
                margin: 0 4px 7px;
                font-size: 9px;
            }

            .sidebar-nav {
                margin-right: -15px;
                padding: 0 15px 5px 0;
                flex-direction: row;
                gap: 7px;
                overflow-x: auto;
                scrollbar-width: thin;
                scrollbar-color: rgba(255, 255, 255, .35) transparent;
            }

            .sidebar-nav .side-link {
                min-height: 36px;
                padding: 9px 11px;
                flex: 0 0 auto;
                font-size: 12px;
                white-space: nowrap;
            }

            .sidebar-bottom {
                margin-top: 9px;
                padding-top: 9px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 10px;
                border-top: 1px solid rgba(255, 255, 255, .15);
            }

            .sidebar-bottom .side-link {
                min-height: 36px;
                padding: 8px 9px;
                font-size: 12px;
            }

            .logout-form {
                margin: 0;
                flex: 0 0 auto;
            }

            .logout-btn {
                width: auto;
                min-height: 36px;
                padding: 8px 12px;
                font-size: 12px;
                text-align: center;
            }

            .content {
                padding: 25px 15px 38px;
            }

            .page-header {
                align-items: flex-start;
                flex-direction: column;
                gap: 16px;
            }

            .create-btn {
                width: 100%;
            }

            .search-form {
                display: grid;
                grid-template-columns: minmax(0, 1fr) auto auto;
                gap: 7px;
            }

            .search-form input {
                grid-column: 1 / -1;
            }

            .search-btn,
            .clear-btn {
                width: 100%;
            }

            .activity-card {
                padding: 16px;
            }

            .details-grid {
                gap: 9px 16px;
                padding: 12px;
            }
        }

        @@media (max-width: 360px) {
            .sidebar-bottom .side-link {
                font-size: 11px;
            }

            .content {
                padding-right: 12px;
                padding-left: 12px;
            }

            .search-form {
                grid-template-columns: 1fr 1fr;
            }

            .search-form input {
                grid-column: 1 / -1;
            }

            .details-grid {
                flex-direction: column;
            }

            .card-actions {
                gap: 7px;
            }

            .action-btn {
                padding-right: 9px;
                padding-left: 9px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    </style>
</head>

<body>
    <div class="main-layout">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">CK</span>
                <span>CampusKonnect</span>
            </a>

            <p class="sidebar-heading">CAMPUS ACTIVITIES</p>

            <nav class="sidebar-nav" aria-label="Activity filters">
                <a asp-controller="Activities"
                   asp-action="Index"
                   asp-route-filter="all"
                   class="side-link @(currentFilter == "all" ? "active" : "")">
                    All Activities
                </a>

                <a asp-controller="Activities"
                   asp-action="Create"
                   class="side-link">
                    + Create Activity
                </a>

                <a asp-controller="Activities"
                   asp-action="Index"
                   asp-route-filter="created"
                   class="side-link @(currentFilter == "created" ? "active" : "")">
                    My Created Activities
                </a>

                <a asp-controller="Activities"
                   asp-action="Index"
                   asp-route-filter="joined"
                   class="side-link @(currentFilter == "joined" ? "active" : "")">
                    My Joined Activities
                </a>
            </nav>

            <div class="sidebar-bottom">
                <a asp-controller="Home"
                   asp-action="Dashboard"
                   class="side-link">
                    ← Back to Dashboard
                </a>

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit" class="logout-btn">
                        Logout
                    </button>
                </form>
            </div>
        </aside>

        <main class="content">
            <div class="content-inner">
                <header class="page-header">
                    <div class="page-heading">
                        <p class="eyebrow">Discover and connect</p>
                        <h1>Campus Activities</h1>
                        <p>Explore and participate in activities around your campus.</p>
                    </div>

                    <a asp-controller="Activities"
                       asp-action="Create"
                       class="create-btn">
                        <span aria-hidden="true">+</span>
                        <span>Create Activity</span>
                    </a>
                </header>

                @if (TempData["Message"] != null)
                {
                    <div class="message" role="status">
                        @TempData["Message"]
                    </div>
                }

                <form asp-controller="Activities"
                      asp-action="Index"
                      method="get"
                      class="search-form">

                    <input type="hidden"
                           name="filter"
                           value="@currentFilter" />

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Search activities by title..."
                           aria-label="Search activities by title" />

                    <button type="submit" class="search-btn">Search</button>

                    <a asp-controller="Activities"
                       asp-action="Index"
                       asp-route-filter="@currentFilter"
                       class="clear-btn">
                        Clear
                    </a>
                </form>

                @if (Model == null || Model.Count == 0)
                {
                    <div class="empty-state">
                        @if (currentFilter == "created")
                        {
                            <span>You have not created any activities yet.</span>
                        }
                        else if (currentFilter == "joined")
                        {
                            <span>You have not joined any activities yet.</span>
                        }
                        else
                        {
                            <span>No activities are available right now.</span>
                        }
                    </div>
                }
                else
                {
                    <div class="activity-list">
                        @foreach (var activity in Model)
                        {
                            var isJoined = activity.Participants.Any(p =>
                                p.StudentId == ViewBag.CurrentUserId &&
                                p.ParticipationStatus == "Active");

                            <article class="activity-card">
                                <div class="card-top">
                                    <div class="activity-copy">
                                        <h2 class="activity-title">@activity.Title</h2>
                                        <p class="activity-description">@activity.Description</p>
                                    </div>

                                    <div class="badges">
                                        @if (activity.ActivityType == "Online")
                                        {
                                            <span class="badge online">Online</span>
                                        }
                                        else
                                        {
                                            <span class="badge on-campus">On-Campus</span>
                                        }

                                        @if (activity.Status == "Available")
                                        {
                                            <span class="badge available">Available</span>
                                        }
                                        else if (activity.Status == "Full")
                                        {
                                            <span class="badge full">Full</span>
                                        }
                                        else if (activity.Status == "Cancelled")
                                        {
                                            <span class="badge cancelled">Cancelled</span>
                                        }
                                        else if (activity.Status == "Completed")
                                        {
                                            <span class="badge completed">Completed</span>
                                        }
                                    </div>
                                </div>

                                <div class="details-grid">
                                    <span>
                                        <strong>Date:</strong>
                                        @activity.ScheduledAt.ToString("dd MMM yyyy")
                                    </span>

                                    <span>
                                        <strong>Time:</strong>
                                        @activity.ScheduledAt.ToString("hh:mm tt")
                                    </span>

                                    @if (activity.ActivityType == "OnCampus")
                                    {
                                        <span>
                                            <strong>Location:</strong>
                                            @activity.Location
                                        </span>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(activity.Platform))
                                    {
                                        <span>
                                            <strong>Platform:</strong>
                                            @activity.Platform
                                        </span>
                                    }

                                    <span>
                                        <strong>Created By:</strong>
                                        @activity.CreatedByUser?.FullName
                                    </span>

                                    <span>
                                        <strong>Participants:</strong>
                                        @activity.Participants.Count(p =>
                                            p.ParticipationStatus == "Active")
                                        / @activity.MaximumParticipants
                                    </span>
                                </div>

                                <div class="card-actions">
                                    @if (activity.CreatedByUserId == ViewBag.CurrentUserId)
                                    {
                                        @if (activity.Status != "Cancelled" &&
                                             activity.Status != "Completed")
                                        {
                                            <a asp-controller="Activities"
                                               asp-action="Edit"
                                               asp-route-id="@activity.ActivityId"
                                               class="action-btn edit-btn">
                                                Edit Activity
                                            </a>

                                            <form asp-controller="Activities"
                                                  asp-action="Cancel"
                                                  asp-route-id="@activity.ActivityId"
                                                  method="post"
                                                  class="action-form"
                                                  onsubmit="return confirm('Are you sure you want to cancel this activity?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="action-btn cancel-btn">
                                                    Cancel Activity
                                                </button>
                                            </form>
                                        }
                                    }
                                    else
                                    {
                                        @if (isJoined)
                                        {
                                            @if (activity.ScheduledAt > DateTime.Now &&
                                                 activity.Status != "Cancelled" &&
                                                 activity.Status != "Completed")
                                            {
                                                <form asp-controller="Activities"
                                                      asp-action="Leave"
                                                      asp-route-id="@activity.ActivityId"
                                                      method="post"
                                                      class="action-form">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="action-btn leave-btn">
                                                        Leave Activity
                                                    </button>
                                                </form>
                                            }
                                        }
                                        else if (activity.ScheduledAt > DateTime.Now &&
                                                 activity.Status == "Available")
                                        {
                                            <form asp-controller="Activities"
                                                  asp-action="Join"
                                                  asp-route-id="@activity.ActivityId"
                                                  method="post"
                                                  class="action-form">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="action-btn join-btn">
                                                    Join Activity
                                                </button>
                                            </form>
                                        }
                                    }

                                    <a asp-controller="Activities"
                                       asp-action="Details"
                                       asp-route-id="@activity.ActivityId"
                                       class="action-btn view-btn">
                                        View Details
                                    </a>
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </main>
    </div>
</body>
</html>