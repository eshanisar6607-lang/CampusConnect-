@model CampusKonnect.Models.CreateActivityViewModel

@{
    Layout = null;
    ViewData["Title"] = "Edit Activity";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Edit Activity - CampusKonnect</title>

    <style>
        :root {
            --forest: #244C3A;
            --forest-dark: #193A2B;
            --sage: #648A70;
            --soft-sage: #E5EEE7;
            --light: #F5F8F5;
            --dark: #26352C;
            --muted: #718078;
            --border: #DFE8E0;
            --error: #B52E2E;
            --shadow: 0 18px 45px rgba(36, 76, 58, .08);
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            margin: 0;
            padding: 28px 18px 48px;
            background:
                radial-gradient(circle at 90% 5%, rgba(220, 233, 223, .65), transparent 24rem),
                var(--light);
            color: var(--dark);
            font-family: "Segoe UI", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .page-container {
            width: min(100%, 820px);
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--forest);
            font-size: 20px;
            font-weight: 760;
            letter-spacing: -.35px;
            text-decoration: none;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: var(--forest);
            color: #FFFFFF;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .page-label {
            color: var(--muted);
            font-size: 13px;
            font-weight: 600;
        }

        .form-card {
            padding: clamp(22px, 5vw, 38px);
            border: 1px solid var(--border);
            border-radius: 20px;
            background: #FFFFFF;
            box-shadow: var(--shadow);
        }

        .form-heading {
            margin-bottom: 27px;
            padding-bottom: 22px;
            border-bottom: 1px solid #EDF1ED;
        }

        .eyebrow {
            margin: 0 0 9px;
            color: var(--sage);
            font-size: 12px;
            font-weight: 750;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .form-heading h1 {
            margin: 0 0 9px;
            color: var(--forest);
            font-size: clamp(25px, 5vw, 32px);
            font-weight: 760;
            letter-spacing: -.8px;
            line-height: 1.2;
        }

        .form-heading p {
            margin: 0;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.65;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 19px 17px;
        }

        .form-group {
            min-width: 0;
        }

        .full-width {
            grid-column: 1 / -1;
        }

        label {
            display: block;
            margin-bottom: 8px;
            color: #34483A;
            font-size: 13px;
            font-weight: 700;
        }

        input,
        textarea,
        select {
            width: 100%;
            min-height: 46px;
            padding: 11px 13px;
            border: 1px solid #D5DED7;
            border-radius: 9px;
            background: #FFFFFF;
            color: var(--dark);
            font: inherit;
            font-size: 14px;
            transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
        }

        input::placeholder,
        textarea::placeholder {
            color: #98A39B;
        }

        input:hover,
        textarea:hover,
        select:hover {
            border-color: #AEBFB1;
        }

        input:focus,
        textarea:focus,
        select:focus {
            outline: none;
            border-color: var(--sage);
            box-shadow: 0 0 0 3px rgba(100, 138, 112, .15);
        }

        textarea {
            min-height: 125px;
            resize: vertical;
            line-height: 1.6;
        }

        .field-note {
            display: block;
            margin-top: 7px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .validation,
        .validation-summary {
            color: var(--error);
            font-size: 12px;
            line-height: 1.5;
        }

        .validation {
            display: block;
            margin-top: 5px;
        }

        .validation-summary {
            margin: 0 0 18px;
            padding: 11px 14px;
            border: 1px solid #F0D0D0;
            border-radius: 9px;
            background: #FFF7F7;
        }

        .validation-summary:empty {
            display: none;
        }

        .validation-summary ul {
            margin: 0;
            padding-left: 18px;
        }

        [hidden] {
            display: none !important;
        }

        .form-actions {
            margin-top: 28px;
            padding-top: 21px;
            border-top: 1px solid #EDF1ED;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 11px;
        }

        .submit-btn,
        .cancel-btn {
            min-height: 46px;
            padding: 11px 19px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid transparent;
            border-radius: 9px;
            font: inherit;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            cursor: pointer;
            transition: transform .2s ease, background .2s ease, color .2s ease, box-shadow .2s ease;
        }

        .submit-btn {
            background: var(--forest);
            color: #FFFFFF;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            background: var(--forest-dark);
            box-shadow: 0 7px 16px rgba(36, 76, 58, .17);
        }

        .cancel-btn {
            border-color: #DCE5DE;
            background: #F3F6F3;
            color: var(--dark);
        }

        .cancel-btn:hover {
            transform: translateY(-2px);
            border-color: #C7D7CA;
            background: var(--soft-sage);
            color: var(--forest);
        }

        .submit-btn:focus-visible,
        .cancel-btn:focus-visible {
            outline: 3px solid rgba(100, 138, 112, .35);
            outline-offset: 3px;
        }

        @@media (max-width: 600px) {
            body {
                padding: 19px 13px 32px;
            }

            .page-header {
                margin-bottom: 16px;
            }

            .page-label {
                font-size: 12px;
            }

            .form-card {
                padding: 23px 19px;
                border-radius: 16px;
            }

            .form-heading {
                margin-bottom: 22px;
                padding-bottom: 18px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 17px;
            }

            .full-width {
                grid-column: auto;
            }

            .form-actions {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }
        }

        @@media (max-width: 360px) {
            .brand {
                gap: 7px;
                font-size: 17px;
            }

            .brand-mark {
                width: 34px;
                height: 34px;
            }

            .page-label {
                max-width: 92px;
                text-align: right;
            }

            .form-actions {
                grid-template-columns: 1fr;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    </style>
</head>

<body>
    <main class="page-container">
        <header class="page-header">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">CK</span>
                <span>CampusKonnect</span>
            </a>

            <span class="page-label">Student Community</span>
        </header>

        <section class="form-card" aria-labelledby="form-title">
            <div class="form-heading">
                <p class="eyebrow">Campus activities</p>
                <h1 id="form-title">Edit Campus Activity</h1>
                <p>Update your activity details below.</p>
            </div>

            <form asp-controller="Activities"
                  asp-action="Edit"
                  asp-route-id="@ViewBag.ActivityId"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"
                     role="alert"></div>

                <div class="form-grid">
                    <div class="form-group full-width">
                        <label asp-for="Title">Activity Title</label>
                        <input asp-for="Title"
                               placeholder="For example, Campus Photography Walk" />
                        <span asp-validation-for="Title" class="validation"></span>
                    </div>

                    <div class="form-group full-width">
                        <label asp-for="Description">Description</label>
                        <textarea asp-for="Description"
                                  rows="4"
                                  placeholder="Tell students what the activity is about"></textarea>
                        <span asp-validation-for="Description" class="validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ScheduledAt">Date and Time</label>
                        <input asp-for="ScheduledAt"
                               type="datetime-local"
                               asp-format="{0:yyyy-MM-ddTHH:mm}" />
                        <span asp-validation-for="ScheduledAt" class="validation"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ActivityType">Activity Type</label>
                        <select asp-for="ActivityType" id="activityType">
                            <option value="OnCampus">On-Campus</option>
                            <option value="Online">Online</option>
                        </select>
                        <span asp-validation-for="ActivityType" class="validation"></span>
                    </div>

                    <div id="onCampusFields" class="form-group full-width">
                        <label asp-for="Location">Location</label>
                        <input asp-for="Location"
                               placeholder="Enter the campus location" />
                        <span asp-validation-for="Location" class="validation"></span>
                    </div>

                    <div id="onlineFields" class="full-width" hidden>
                        <div class="form-group" style="margin-bottom: 18px;">
                            <label asp-for="Platform">Meeting Platform</label>
                            <select asp-for="Platform">
                                <option value="">Select a platform</option>
                                <option value="Google Meet">Google Meet</option>
                                <option value="Zoom">Zoom</option>
                                <option value="Microsoft Teams">Microsoft Teams</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label asp-for="MeetingLink">Meeting Link (Optional)</label>
                            <input asp-for="MeetingLink"
                                   placeholder="https://..." />
                            <span asp-validation-for="MeetingLink" class="validation"></span>
                            <small class="field-note">
                                You can add or update the meeting link later.
                            </small>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="MaximumParticipants">Maximum Participants</label>
                        <input asp-for="MaximumParticipants"
                               type="number"
                               min="2"
                               max="500"
                               placeholder="For example, 30" />
                        <span asp-validation-for="MaximumParticipants" class="validation"></span>
                    </div>
                </div>

                <div class="form-actions">
                    <button type="submit" class="submit-btn">Save Changes</button>

                    <a asp-controller="Activities"
                       asp-action="Index"
                       asp-route-filter="created"
                       class="cancel-btn">
                        Cancel
                    </a>
                </div>
            </form>
        </section>
    </main>

    <partial name="_ValidationScriptsPartial" />

    <script>
        const activityType = document.getElementById("activityType");
        const onCampusFields = document.getElementById("onCampusFields");
        const onlineFields = document.getElementById("onlineFields");

        function updateActivityFields() {
            const isOnline = activityType.value === "Online";

            onCampusFields.hidden = isOnline;
            onlineFields.hidden = !isOnline;
        }

        activityType.addEventListener("change", updateActivityFields);
        updateActivityFields();
    </script>
</body>
</html>