@model CampusKonnect.Models.Activity

@{
    ViewData["Title"] = "Activity Details";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Activity Details - CampusKonnect</title>

    <style>
        :root {
            --forest: #244C3A;
            --forest-dark: #193A2B;
            --sage: #648A70;
            --soft-sage: #E5EEE7;
            --light: #F5F8F5;
            --dark: #26352C;
            --muted: #718078;
            --border: #DFE8E0;
            --shadow: 0 18px 45px rgba(36, 76, 58, .08);
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            min-height: 100vh;
            margin: 0;
            padding: 28px 18px 48px;
            background:
                radial-gradient(circle at 90% 5%, rgba(220, 233, 223, .65), transparent 24rem),
                var(--light);
            color: var(--dark);
            font-family: "Segoe UI", Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        .page {
            width: min(100%, 900px);
            margin: 0 auto;
        }

        .page-header {
            margin-bottom: 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: var(--forest);
            font-size: 20px;
            font-weight: 760;
            letter-spacing: -.35px;
            text-decoration: none;
        }

        .brand-mark {
            width: 38px;
            height: 38px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: var(--forest);
            color: #FFFFFF;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .page-label {
            color: var(--muted);
            font-size: 13px;
            font-weight: 600;
        }

        .details-card {
            padding: clamp(22px, 5vw, 38px);
            border: 1px solid var(--border);
            border-radius: 20px;
            background: #FFFFFF;
            box-shadow: var(--shadow);
        }

        .heading {
            margin-bottom: 14px;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
        }

        .heading-copy {
            min-width: 0;
        }

        .eyebrow {
            margin: 0 0 9px;
            color: var(--sage);
            font-size: 12px;
            font-weight: 750;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        h1 {
            margin: 0;
            color: var(--forest);
            font-size: clamp(25px, 5vw, 34px);
            font-weight: 760;
            letter-spacing: -.8px;
            line-height: 1.2;
            overflow-wrap: anywhere;
        }

        .status {
            flex: 0 0 auto;
            margin-top: 2px;
            padding: 8px 13px;
            border: 1px solid #D8E6DA;
            border-radius: 30px;
            background: var(--soft-sage);
            color: var(--forest);
            font-size: 12px;
            font-weight: 750;
            line-height: 1.2;
        }

        .description {
            margin: 17px 0 26px;
            color: var(--muted);
            font-size: 15px;
            line-height: 1.8;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        .divider {
            height: 1px;
            margin: 26px 0;
            border: 0;
            background: var(--border);
        }

        .section-title {
            margin: 0 0 15px;
            color: var(--forest);
            font-size: 17px;
            font-weight: 740;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 13px;
        }

        .info-box {
            min-width: 0;
            padding: 16px;
            border: 1px solid var(--border);
            border-radius: 12px;
            background: #F8FAF8;
            transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
        }

        .info-box:hover {
            transform: translateY(-2px);
            border-color: #C6D6C9;
            box-shadow: 0 7px 18px rgba(36, 76, 58, .06);
        }

        .info-label {
            margin-bottom: 7px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .info-value {
            color: var(--dark);
            font-size: 14px;
            font-weight: 650;
            line-height: 1.55;
            overflow-wrap: anywhere;
        }

        .meeting-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: var(--forest);
            font-weight: 750;
            text-decoration: none;
        }

        .meeting-link::after {
            content: "↗";
            font-size: 15px;
            transition: transform .2s ease;
        }

        .meeting-link:hover {
            color: var(--sage);
            text-decoration: underline;
            text-underline-offset: 3px;
        }

        .meeting-link:hover::after {
            transform: translate(2px, -2px);
        }

        .participants {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .participant {
            max-width: 100%;
            padding: 9px 13px;
            border: 1px solid #D8E6DA;
            border-radius: 30px;
            background: var(--soft-sage);
            color: var(--forest);
            font-size: 13px;
            font-weight: 650;
            overflow-wrap: anywhere;
        }

        .empty {
            margin: 0;
            padding: 15px;
            border: 1px dashed #CBD9CE;
            border-radius: 11px;
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .back-btn {
            min-height: 45px;
            margin-top: 27px;
            padding: 11px 17px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            border: 1px solid var(--forest);
            border-radius: 9px;
            background: var(--forest);
            color: #FFFFFF;
            font-size: 14px;
            font-weight: 700;
            text-decoration: none;
            transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
        }

        .back-btn::before {
            content: "←";
            font-size: 17px;
            line-height: 1;
            transition: transform .2s ease;
        }

        .back-btn:hover {
            transform: translateY(-2px);
            background: var(--forest-dark);
            box-shadow: 0 7px 16px rgba(36, 76, 58, .17);
            color: #FFFFFF;
        }

        .back-btn:hover::before {
            transform: translateX(-3px);
        }

        .back-btn:focus-visible,
        .meeting-link:focus-visible {
            outline: 3px solid rgba(100, 138, 112, .4);
            outline-offset: 3px;
        }

        @@media (max-width: 600px) {
            body {
                padding: 19px 13px 32px;
            }

            .page-header {
                margin-bottom: 16px;
            }

            .page-label {
                font-size: 12px;
            }

            .details-card {
                padding: 23px 19px;
                border-radius: 16px;
            }

            .heading {
                align-items: flex-start;
                flex-direction: column;
                gap: 12px;
            }

            .status {
                margin-top: 0;
            }

            .description {
                margin: 15px 0 22px;
                font-size: 14px;
            }

            .info-grid {
                grid-template-columns: 1fr;
                gap: 10px;
            }

            .info-box {
                padding: 14px;
            }

            .divider {
                margin: 22px 0;
            }
        }

        @@media (max-width: 360px) {
            .brand {
                gap: 7px;
                font-size: 17px;
            }

            .brand-mark {
                width: 34px;
                height: 34px;
            }

            .page-label {
                max-width: 92px;
                text-align: right;
            }

            .back-btn {
                width: 100%;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition-duration: .01ms !important;
                animation-duration: .01ms !important;
                animation-iteration-count: 1 !important;
            }
        }
    </style>
</head>

<body>
    <main class="page">
        <header class="page-header">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark" aria-hidden="true">CK</span>
                <span>CampusKonnect</span>
            </a>

            <span class="page-label">Activity details</span>
        </header>

        <article class="details-card">
            <div class="heading">
                <div class="heading-copy">
                    <p class="eyebrow">Campus activity</p>
                    <h1>@Model.Title</h1>
                </div>

                <span class="status">@Model.Status</span>
            </div>

            <p class="description">@Model.Description</p>

            <hr class="divider" />

            <section aria-labelledby="activity-info-title">
                <h2 class="section-title" id="activity-info-title">
                    Activity Information
                </h2>

                <div class="info-grid">
                    <div class="info-box">
                        <div class="info-label">Date &amp; Time</div>
                        <div class="info-value">
                            @Model.ScheduledAt.ToString("dd MMM yyyy, hh:mm tt")
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Activity Type</div>
                        <div class="info-value">@Model.ActivityType</div>
                    </div>

                    @if (Model.ActivityType == "OnCampus")
                    {
                        <div class="info-box">
                            <div class="info-label">Location</div>
                            <div class="info-value">
                                @(Model.Location ?? "Not specified")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="info-box">
                            <div class="info-label">Platform</div>
                            <div class="info-value">
                                @(Model.Platform ?? "Not specified")
                            </div>
                        </div>

                        @if (ViewBag.CanSeeMeetingLink == true)
                        {
                            <div class="info-box">
                                <div class="info-label">Meeting Link</div>
                                <div class="info-value">
                                    @if (!string.IsNullOrWhiteSpace(Model.MeetingLink))
                                    {
                                        <a class="meeting-link"
                                           href="@Model.MeetingLink"
                                           target="_blank"
                                           rel="noopener noreferrer">
                                            Join Meeting
                                        </a>
                                    }
                                    else
                                    {
                                        <span>Meeting link has not been added yet.</span>
                                    }
                                </div>
                            </div>
                        }
                    }

                    <div class="info-box">
                        <div class="info-label">Created By</div>
                        <div class="info-value">
                            @(Model.CreatedByUser?.FullName ?? "Unknown")
                        </div>
                    </div>

                    <div class="info-box">
                        <div class="info-label">Participants</div>
                        <div class="info-value">
                            @ViewBag.CurrentParticipants / @Model.MaximumParticipants
                        </div>
                    </div>
                </div>
            </section>

            @if (ViewBag.IsCreator == true || ViewBag.IsJoined == true)
            {
                <hr class="divider" />

                <section aria-labelledby="participants-title">
                    <h2 class="section-title" id="participants-title">
                        Joined Students
                    </h2>

                    @if (ViewBag.UniqueParticipants != null &&
                         ViewBag.UniqueParticipants.Count > 0)
                    {
                        <div class="participants">
                            @foreach (var participant in ViewBag.UniqueParticipants)
                            {
                                <span class="participant">
                                    @(participant.Student?.FullName ?? "Student")
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="empty">No students have joined yet.</p>
                    }
                </section>
            }

            <a asp-controller="Activities"
               asp-action="Index"
               asp-route-filter="all"
               class="back-btn">
                Back to Activities
            </a>
        </article>
    </main>
</body>
</html>