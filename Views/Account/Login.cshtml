@model CampusKonnect.Models.LoginViewModel

@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Student Login";
}

<style>
    .login-page {
        min-height: calc(100vh - 80px);
        padding: 48px 16px;
        display: flex;
        align-items: center;
        background:
            radial-gradient(circle at 85% 10%, rgba(220, 233, 223, .6), transparent 24rem),
            #F6F8F6;
    }

    .login-card {
        width: 100%;
        max-width: 480px;
        margin: 0 auto;
        padding: clamp(24px, 5vw, 40px);
        border: 1px solid #E3EAE4;
        border-radius: 20px;
        background: #FFFFFF;
        box-shadow: 0 18px 45px rgba(36, 76, 58, .09);
    }

    .login-heading {
        margin-bottom: 26px;
        text-align: center;
    }

    .login-mark {
        width: 48px;
        height: 48px;
        margin: 0 auto 16px;
        display: grid;
        place-items: center;
        border-radius: 15px;
        background: #244C3A;
        color: #FFFFFF;
        font-size: 16px;
        font-weight: 800;
    }

    .login-heading h1 {
        margin: 0 0 8px;
        color: #244C3A;
        font-size: clamp(25px, 5vw, 30px);
        font-weight: 750;
        letter-spacing: -.6px;
    }

    .login-heading p {
        margin: 0;
        color: #718078;
        font-size: 14px;
        line-height: 1.6;
    }

    .login-form .form-label {
        margin-bottom: 7px;
        color: #34483A;
        font-size: 13px;
        font-weight: 700;
    }

    .login-form .form-control {
        min-height: 47px;
        padding: 11px 13px;
        border: 1px solid #D5DED7;
        border-radius: 9px;
        color: #26352C;
        font-size: 14px;
        transition: border-color .2s ease, box-shadow .2s ease;
    }

    .login-form .form-control::placeholder {
        color: #98A39B;
    }

    .login-form .form-control:focus {
        border-color: #648A70;
        box-shadow: 0 0 0 3px rgba(100, 138, 112, .15);
    }

    .login-form .text-danger {
        display: block;
        margin-top: 5px;
        font-size: 12px;
    }

    .login-validation:empty {
        display: none;
    }

    .login-validation {
        padding: 11px 13px;
        border: 1px solid #F0D0D0;
        border-radius: 9px;
        background: #FFF7F7;
        font-size: 13px;
    }

    .login-validation ul {
        margin: 0;
        padding-left: 18px;
    }

    .remember-row {
        margin: 3px 0 22px;
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .remember-row input {
        width: 17px;
        height: 17px;
        margin: 0;
        accent-color: #244C3A;
        cursor: pointer;
    }

    .remember-row label {
        margin: 0;
        color: #53645A;
        font-size: 13px;
        cursor: pointer;
    }

    .login-submit {
        min-height: 48px;
        border: 0;
        border-radius: 9px;
        background: #244C3A;
        color: #FFFFFF;
        font-size: 14px;
        font-weight: 700;
        transition: transform .2s ease, background .2s ease, box-shadow .2s ease;
    }

    .login-submit:hover {
        transform: translateY(-2px);
        background: #193A2B;
        box-shadow: 0 7px 16px rgba(36, 76, 58, .18);
        color: #FFFFFF;
    }

    .login-submit:focus-visible {
        outline: 3px solid rgba(100, 138, 112, .4);
        outline-offset: 3px;
    }

    .login-footer {
        margin: 21px 0 0;
        color: #718078;
        font-size: 13px;
        text-align: center;
    }

    .login-footer a {
        color: #244C3A;
        font-weight: 700;
        text-decoration: none;
    }

    .login-footer a:hover {
        color: #648A70;
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    @@media (max-width: 576px) {
        .login-page {
            min-height: auto;
            padding: 28px 13px;
        }

        .login-card {
            border-radius: 16px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            transition-duration: .01ms !important;
        }
    }
</style>

<main class="login-page">
    <section class="login-card" aria-labelledby="login-title">
        <header class="login-heading">
            <div class="login-mark" aria-hidden="true">CK</div>
            <h1 id="login-title">Student Login</h1>
            <p>Sign in to continue to your CampusKonnect account.</p>
        </header>

        <form asp-action="Login"
              method="post"
              class="login-form">

            <div asp-validation-summary="All"
                 class="text-danger mb-3 login-validation"
                 role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">UET Email</label>
                <input asp-for="Email"
                       class="form-control"
                       placeholder="2024-SE-255@student.uet.edu.pk"
                       autocomplete="username"
                       inputmode="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Password</label>
                <input asp-for="Password"
                       class="form-control"
                       placeholder="Enter your password"
                       autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="remember-row">
                <input asp-for="RememberMe" />
                <label asp-for="RememberMe">Remember me</label>
            </div>

            <button type="submit" class="btn login-submit w-100">
                Log In
            </button>
        </form>

        <p class="login-footer">
            Don't have an account?
            <a asp-controller="Account" asp-action="Register">Register here</a>
        </p>
    </section>
</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}